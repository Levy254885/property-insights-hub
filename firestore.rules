rules_version = '2';

// Property Masters — production Firestore rules.
// Public visitors get read-only access to catalogue data and may only create
// enquiries / viewing requests. Everything else requires a staff account.
//
// Staff are recognised in two ways so the dashboard works from day one:
//   1. an allow-listed company email address (bootstrap administrators), or
//   2. a users/{uid} document carrying a staff role.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return isSignedIn() ? request.auth.token.email : '';
    }

    function isAllowlisted() {
      return email() in [
        'admin@propertymasters.co.ke',
        'nicholas@propertymasters.co.ke'
      ];
    }

    function roleOf() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRoleDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff() {
      return isAllowlisted()
        || (hasRoleDoc() && roleOf() in ['staff', 'admin', 'super_admin']);
    }

    function isAdmin() {
      return isAllowlisted()
        || (hasRoleDoc() && roleOf() in ['admin', 'super_admin']);
    }

    // Catalogue: world readable, staff writable.
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isStaff();

      match /images/{imageId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    match /propertyTypes/{id}   { allow read: if true; allow write: if isStaff(); }
    match /locations/{id}       { allow read: if true; allow write: if isStaff(); }
    match /propertySpecialists/{id} { allow read: if true; allow write: if isStaff(); }
    match /articles/{id}        { allow read: if true; allow write: if isStaff(); }
    match /settings/{id}        { allow read: if true; allow write: if isAdmin(); }

    // Leads: anyone can submit (property enquiries and general contact
    // messages alike), only staff can read or manage them.
    match /enquiries/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 1
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 4000;
      allow read, update, delete: if isStaff();
    }

    match /viewingRequests/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 1
                    && request.resource.data.name.size() <= 120;
      allow read, update, delete: if isStaff();
    }

    // Staff role documents. A signed-in user may create/read their own record;
    // only administrators can change or remove roles afterwards.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }
  }
}
